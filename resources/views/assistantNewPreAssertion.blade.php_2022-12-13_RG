        <script type="application/javascript">
            $(function() {
                
                $('.form-check-input').change(function() {
    
                    var actBadgeID = ($(this).attr('id'));
    
                    $('div#collapseThree div.accordion-body div').remove();

                    $('button[aria-controls=collapseThree]').prop('disabled', false);
                   
                    
                   // console.log(actBadgeID);
                    //console.log({!! json_encode($badgeclasslist->toArray()) !!});
                    var allBadges = {!! json_encode($badgeclasslist->toArray()) !!};
                   //var allBadges = JSON.parse({!! json_encode($badgeclasslist->toArray()) !!});
    
                   //console.log(allBadges);
                   $.each(allBadges, function(index, value){
                        if(value.badgeclassID == actBadgeID){
    
    
                            //console.log(value.type);
    
                            var badgeType = JSON.parse(value.type);
    
                            //console.log(badgeType.header.name);
    
                            $.each(badgeType.form, function(i2, v2){
    
                                //console.log(v2.name);
    
                               
    
                                if (v2.selected == "true"){
    
                                    //console.log(v2.name);
                                    var tmpFields = $('<div class="row typefields" id="'+v2.id+'"><h3>'+v2.name+'</h3><i>'+v2.description+'</i></div>');
    
                                    var tmpUL = $('<ul></ul>');
                                    $.each(v2.fields, function(i3, v3){
                                       
                                        var disabled = '';

                                        if ((v3.id).slice(15,17) != '00'){
                                            disabled = 'disabled';
                                        }

                                       
                                        if((v3.content) == null ){

                                            v3.content = '';
                                        }

                                        tmpUL.append('<li><strong>'+v3.name+'</strong>(<i>'+v3.type+'</i>)<br />'
                                            
                                            +'<textarea style="resize: none;" name="'+v3.id+'" class="form-control" id="'+v3.id+'" rows="1" '+disabled+'>'+v3.content+'</textarea>'
                                            +'</li>');
                                        
                                        // console.log(v3.name);
    
                                    });
    
                                    tmpFields.append(tmpUL);
    
                                    $('div#collapseThree div.accordion-body').append(tmpFields);
    
                                }
    
                            });
                        }
                   });
    
                   
    
                });
    
    
            });
        </script>


