	$bd_hu = $hu_fmt -> format($bd);
	$bd_hu_nap = $bd -> format("j");
	if ($bd_hu_nap === "12") { $bds_hu = "-én";}
	else {
	    switch ($bd_hu_nap % 10){
		case 1:
		case 4:
		case 5:
		case 7:
		case 9:
		    $bds_hu = "-én";
		    break;
		case 2:
		case 3:
		case 6:
		case 8:
		    $bds_hu = "-án";
		    break;
		case 0:
		    {
			switch ($bd_hu_nap){
			    case 10:
				$bds_hu = "-én";
				break;
			    default:
				$bds_hu = "-án";
			}
		    }
	    }
	}
	$bd_en = $bd -> format("j F Y");
